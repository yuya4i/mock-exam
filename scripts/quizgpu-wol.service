# systemd unit for the GPU Wake-on-LAN web trigger (runs on pi-calc).
#
# Install:
#   sudo cp ~/workspace/quiz-app/scripts/quizgpu-wol.service /etc/systemd/system/
#   sudo tee /etc/quizgpu-wol.env >/dev/null <<'EOF'
#   GPU_MAC=2C-FD-A1-DE-74-DD
#   GPU_BROADCAST=192.168.10.255
#   WOL_PORT=8787
#   # WOL_TOKEN=<任意の秘密文字列>   # 付けると /wake に ?token= が必須
#   EOF
#   sudo systemctl daemon-reload && sudo systemctl enable --now quizgpu-wol
#
# Then on your phone:  http://192.168.10.14:8787/   (同一LAN)
#                  or  http://100.106.108.22:8787/  (Tailscale)
[Unit]
Description=quiz-app GPU Wake-on-LAN web trigger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sna
EnvironmentFile=-/etc/quizgpu-wol.env
ExecStart=/usr/bin/python3 /home/sna/workspace/quiz-app/scripts/wol_server.py
Restart=on-failure
RestartSec=3
# Hardening (it only needs the network to send a broadcast).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
